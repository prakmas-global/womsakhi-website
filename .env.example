# WomSakhi website — environment
# ---------------------------------------------------------------------------
# Copy this to .env.local and fill in real values:
#
#     cp .env.example .env.local
#
# .env.local is git-ignored and must stay that way. Nothing secret belongs in
# THIS file — it is the committed template, and it is read by people who do not
# have production access.
#
# ⚠ .gitignore currently ignores `.env*`, which covers .env.local correctly but
#   also covers this file, so `git add .env.example` silently does nothing. The
#   one-line fix, which both sibling repos already have, is to add `!.env.example`
#   under the env block in .gitignore. Until that lands, commit this with
#   `git add -f .env.example`.
#
# STATE OF PLAY (verified 2026-09-11 with `grep -rn process.env src/`):
# nothing under src/ reads process.env at all. The site is static and its URLs
# are literals in src/lib/site.ts. Every variable below is marked either
# [runtime] — the platform sets it — or [not read yet] — the shape the site is
# expected to grow into. Wiring one up means changing src/, not just this file.
# ---------------------------------------------------------------------------


# ── Where this site is, and where it sends people ──────────────────────────

# [not read yet] The canonical origin of this site. Would back `metadataBase`
# in src/app/layout.tsx, plus canonical links, sitemap.xml and robots.txt.
# Today layout.tsx uses SITE.url from src/lib/site.ts instead.
#
# It must be an absolute URL with a scheme. A relative value makes Next emit
# relative Open Graph URLs, which Facebook and WhatsApp reject silently — the
# link preview simply never appears and nothing logs an error.
#
# Local: http://localhost:3200   Production: https://www.womsakhi.com
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# [not read yet] The product. Every call to action on this site is a link to
# it. Hard-coded in src/lib/site.ts today (SITE.app / SITE.signup / SITE.signin
# and each pillar's href).
#
# Point it at a staging deployment to click through the whole hand-over without
# creating accounts on production.
NEXT_PUBLIC_APP_URL=https://app.womsakhi.com

# [not read yet] The product's public API. The only endpoint this site has any
# business calling is the unauthenticated stats one:
#
#     ${NEXT_PUBLIC_API_URL}/public/stats
#
# There is deliberately no live fetch today — the numbers in src/lib/site.ts
# are copied from it by hand, so the site cannot render a wrong number because
# a request failed, and cannot render a spinner where a number should be.
#
# Two things to know before wiring it up. NEXT_PUBLIC_* is inlined into the
# browser bundle by `next build`, so changing it on a running container does
# nothing at all — the image has to be rebuilt. And the API's ALLOWED_ORIGINS
# is an explicit list, not a wildcard: www.womsakhi.com has to be added to it
# on the API side, or every request fails CORS while the server log shows a
# healthy 200.
NEXT_PUBLIC_API_URL=https://api.womsakhi.com/api/v1


# ── Runtime, set by the platform ───────────────────────────────────────────

# [runtime] The port the server binds to.
#
# Locally this is 3200 and the reason is not arbitrary: port 3000 on the dev
# machine belongs to an unrelated Docker stack, 3100 is the product frontend
# and 8020 is the product API. `next dev` defaults to 3000, so the port has to
# be given every time — either here or as `npm run dev -- --port 3200`.
#
# On Cloud Run this is injected and is NOT negotiable. A container that listens
# on a port of its own choosing never passes its health check, and the deploy
# fails with a message about the container not starting, which sends you
# looking at the application instead of the port.
PORT=3200

# [runtime] Interface to bind to. Leave unset locally. Must be 0.0.0.0 in a
# container — the default binds to localhost inside the container, where
# nothing outside it can reach the process.
# HOSTNAME=0.0.0.0

# [runtime] Do not set NODE_ENV by hand. `next dev` and `next build` set it,
# and overriding it is a reliable way to get a development React into a
# production bundle.


# ── Build ──────────────────────────────────────────────────────────────────

# Next's anonymous telemetry. Off in CI and in the Docker build, so build logs
# stay about the build.
NEXT_TELEMETRY_DISABLED=1


# ── Analytics — not chosen, not wired ──────────────────────────────────────

# [not read yet] No analytics vendor has been picked. When one is, it goes here
# rather than as a hard-coded script tag, so a preview deployment does not
# report into production's numbers.
#
# Whatever is chosen has to be cookie-free and must not block first paint: this
# site is read on mid-range Android phones over slow connections, and a
# render-blocking tag from a third party is measured in the LCP budget in
# CONTRIBUTING.md like everything else.
# NEXT_PUBLIC_ANALYTICS_SRC=
# NEXT_PUBLIC_ANALYTICS_SITE_ID=
